import "std/memops.rin"
import "std/array.rin"
import "std/node.rin"
import "std/slice.rin"
import "std/list.rin"
import "std/print.rin"
import "std/reflect.rin"

payload: struct = {
    x: f32;
    y: *u8;
}

status: enum = {
    ok, err
}

array_slice: proc<T>(source: *array<T>) -> slice<T> = {
    return { .data = source*.data, .length = source*.length };
}

main: proc(argc: i32, argv: *^char)-> i32 = {
    printf("Hello, World!\n");

    num: i32 = 0;
    printfmt("num = {}\n", num);

    array: [4]i32 = {};
    s: status = status.err;

    if (s == status.err) {
        printfmt("{}\n", reflect_name_from_value(s<>&, cast(s, i32)));
    } else {
        printfmt("{}\n", reflect_name_from_value(s<>&, cast(s, i32)));
    }

    arena: memops_arena = {};
    memops_arena_initialize(arena&);

    p: payload = {};
    p.x = 42.0;
    name: ^const char = payload<>.name;
    printfmt("payload.x {}\n", p.x);
    printfmt("name {}\n", name);
    for (i: i32 = 0; i < payload<>.count; i += 1) {
        printfmt("field[{}].name = '{}'\n", i, payload<>.variant.fields[i].name);
    }

    len: u64 = 16;
    temp: memops_arena_temp = memops_arena_temp_begin(arena&);
    payloads: array<payload> = array<payload>reserve(temp.arena, 128);
    printfmt("payloads empty? {}\n", array<payload>is_empty(payloads&));
    writer: slice<payload> = slice<payload>from_array(payloads);
    for (i: u64 = 0; i < writer.length; i += 1) {
        writer.data[i] = { .x = i };
    }
    memops_arena_temp_end(temp);

    numbers: array<i32> = array<i32>reserve(arena&, len);
    for (i: u64 = 0; i < len; i += 1) { 
        numbers.data[i] = cast(i, i32); 
    }
    for (i: u64 = 0; i < len; i += 1 ) {
        printfmt("i = {}, ", numbers.data[i]); 
    }
    printfmt("\n");

    numberchain: *list<payload> = {};
    numberchain = list<payload>create(arena&);
    list<payload>append(arena&, numberchain, { .x = 3.16 });
    list<payload>append(arena&, numberchain, { .x = 8.6 });
    list<payload>append(arena&, numberchain, {});

    node: *node<payload> = numberchain*.head;
    for (i: u64 = 0; i < numberchain*.length; i += 1) {
        printf("%f\n", node*.data.x);
        node = node*.next;
    }

    return 0;
}
